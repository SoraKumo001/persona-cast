# OpenCode Go API Key (OpenCode Consoleから取得したキー)
OPENCODE_API_KEY="your-opencode-api-key-here"

# オプション設定
OPENCODE_BASE_URL="https://opencode.ai/inference/go/openai/v1"
OPENCODE_DEFAULT_MODEL="deepseek-v4.1-flash"
EMBEDDING_MODEL="@cf/baai/bge-m3"

# Cloudflare Access (管理画面 /admin, /api/admin の認証)
# 本番は ACCESS_TEAM_DOMAIN / ACCESS_AUD を設定する。ローカル開発のみ ACCESS_DISABLED=true で検証をスキップ(localhost限定)
ACCESS_DISABLED="true"
ACCESS_TEAM_DOMAIN=""
ACCESS_AUD=""

# 対談チューニング (A/B比較用。"off" で無効化、未設定は ON のまま)
STANCE_PILOT="on"
PERSONA_TEMP_PILOT="on"
KEYPOINT_ASSIGN="on"

# アクセス状況 (任意)。未設定でもアプリは動く (管理画面の「アクセス状況」に設定案内が出る)
# 訪問者ハッシュのソルト (長いランダムな文字列)
ANALYTICS_SALT=
# 集計の取得 (Analytics Engine SQL API)。トークンの権限は Account Analytics の読み取りだけ
CF_ACCOUNT_ID=
CF_API_TOKEN=
